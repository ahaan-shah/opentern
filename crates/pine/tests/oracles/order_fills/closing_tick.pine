//@version=6
// BLOCKED-ORACLE. Run on historical candles. Repeat with "On bar close"
// disabled in Properties, then with immediate exits enabled. With On bar
// close disabled, also run with the ladder enabled to fill on the fourth tick.
strategy("COOF closing tick oracle", calc_on_order_fills=true, process_orders_on_close=true)
int first = input.int(20, "Signal bar")
bool immediate = input.bool(false, "Immediate exit")
bool ladder = input.bool(false, "Fill on four successive ticks")
varip int pass = 0
pass += 1
if bar_index >= first and bar_index <= first + 4
    log.info("bar={0} pass={1} open={2} closed={3} confirmed={4} close={5} equity={6}", bar_index, pass, strategy.opentrades, strategy.closedtrades, barstate.isconfirmed, close, strategy.equity)
if ladder
    if bar_index == first or (bar_index == first + 1 and strategy.opentrades < 4)
        strategy.order("L" + str.tostring(strategy.opentrades), strategy.long, qty=1)
else
    if bar_index == first and strategy.opentrades == 0 and strategy.closedtrades == 0
        strategy.entry("A", strategy.long)
    if strategy.opentrades == 1
        strategy.close("A", immediately=immediate)
