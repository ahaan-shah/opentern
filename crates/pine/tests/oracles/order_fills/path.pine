//@version=6
// BLOCKED-ORACLE. Pick a historical bar with low < open < high and with
// the open closer to the high than to the low. Set Signal bar to its predecessor.
strategy("COOF path oracle", calc_on_order_fills=true, pyramiding=2)
int signal = input.int(20, "Signal bar")
varip int pass = 0
pass += 1
if bar_index >= signal and bar_index <= signal + 2
    log.info("bar={0} pass={1} open={2} closed={3} pos={4}", bar_index, pass, strategy.opentrades, strategy.closedtrades, strategy.position_size)
if bar_index == signal
    strategy.entry("A", strategy.short)
if bar_index == signal + 1 and strategy.opentrades == 1 and strategy.closedtrades == 0
    strategy.entry("B", strategy.short, limit=(open + high) / 2)
if strategy.opentrades == 2
    strategy.exit("TP", "B", limit=(open + low) / 2)
if strategy.closedtrades == 1
    strategy.entry("C", strategy.short, limit=high)
