//@version=5
indicator("Rank Correlation Index", "RCI")
length = input.int(10, "Length", minval = 2)
src = input.source(close, "Source")
rci(s, len) =>
    float d = 0.0
    for i = 0 to len - 1
        higher = 0
        equal = 0
        for j = 0 to len - 1
            if s[j] > s[i]
                higher += 1
            if s[j] == s[i]
                equal += 1
        rank = higher + (equal + 1) / 2
        d += math.pow((i + 1) - rank, 2)
    na(s[len - 1]) ? na : (1 - 6 * d / (len * (len * len - 1))) * 100
plot(rci(src, length), "RCI", #2962FF)
