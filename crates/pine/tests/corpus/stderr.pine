//@version=5
indicator("Standard Error", "StdErr")
length = input.int(21, "Length", minval = 3)
src = input.source(close, "Source")
regression(s, n) =>
    float sy = 0.0
    for i = 0 to n - 1
        sy += s[i]
    mx = (n - 1) / 2
    my = sy / n
    float sxy = 0.0
    float sxx = 0.0
    for i = 0 to n - 1
        dx = (n - 1 - i) - mx
        sxy += dx * (s[i] - my)
        sxx += dx * dx
    slope = sxy / sxx
    icpt = my - slope * mx
    float sse = 0.0
    for i = 0 to n - 1
        sse += math.pow(s[i] - (icpt + slope * (n - 1 - i)), 2)
    [icpt + slope * (n - 1), math.sqrt(sse / (n - 2))]
[line, se] = regression(src, length)
plot(na(src[length - 1]) ? na : se, "Standard Error", #2962FF)
