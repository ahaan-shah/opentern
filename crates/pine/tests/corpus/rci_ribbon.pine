//@version=5
indicator("RCI Ribbon")
src = input.source(close, "Source")
rci(s, len) =>
    float d = 0.0
    for i = 0 to len - 1
        higher = 0
        equal = 0
        for j = 0 to len - 1
            if s[j] > s[i]
                higher += 1
            if s[j] == s[i]
                equal += 1
        rank = higher + (equal + 1) / 2
        d += math.pow((i + 1) - rank, 2)
    na(s[len - 1]) ? na : (1 - 6 * d / (len * (len * len - 1))) * 100
plot(rci(src, input.int(10, "Short RCI Length")), "Short RCI", #F44336)
plot(rci(src, input.int(30, "Middle RCI Length")), "Middle RCI", #2962FF)
plot(rci(src, input.int(50, "Long RCI Length")), "Long RCI", #43A047)
